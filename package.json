{
  "name": "@jsdevlab/zod",
  "version": "1.0.0",
  "private": false,
  "description": "Generate deterministic initial values and reproducible mock data from zod schemas, fully typed as z.output<T>.",
  "keywords": [
    "zod",
    "zod-schema",
    "mock-data",
    "test-data",
    "fixtures",
    "faker",
    "schema-generator",
    "seeded-random",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsdevlab/zod.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE.txt"],
  "scripts": {
    "build": "rslib",
    "changeset": "changeset",
    "check": "biome check",
    "check:write": "biome check --write",
    "coverage": "rstest run --coverage",
    "dev": "rslib --watch",
    "format": "biome format --write",
    "prepare": "simple-git-hooks",
    "release": "changeset publish",
    "test": "tsc --noEmit -p tsconfig.typetests.json && rstest run",
    "test:types": "tsc --noEmit -p tsconfig.typetests.json",
    "test:unit": "rstest run",
    "test:watch": "rstest --watch",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:write",
    "pre-push": "pnpm check"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/node": "^24.13.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <27.0.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
